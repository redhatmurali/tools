      "gridPos": {
        "x": 19,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "description": "Zero is good; >0 means a collector command failed.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(firewall_collector_success == 0) or vector(0)",
